# Copy to .env for local development. All values here are FAKE and only valid for mock OLTs.

# Required, no default: office time zone (IANA).
APP_TIMEZONE=Asia/Jakarta

POSTGRES_USER=olt
POSTGRES_PASSWORD=dev-fake-password-change-me
POSTGRES_DB=olt

# caddy: localhost + internal CA for dev; real domain + ACME email in production.
PUBLIC_DOMAIN=localhost
TLS_ISSUER=internal

# Host ports published by caddy. Change only if something else already listens there (dev).
HTTPS_PORT=443
HTTP_PORT=80

# worker: the only networks it may contact. Dev = mock network (oltnet) only.
OLT_TARGET_CIDRS=172.30.0.0/24
MOCK_OLT_CIDRS=172.30.0.0/24

# api: office LAN, the only networks where the admin role works (no default: fail closed).
# Dev: the Docker bridge (requests through caddy come from the host's bridge IP).
ADMIN_ALLOWED_CIDRS=192.168.0.0/16,172.16.0.0/12
APP_ORIGINS=https://localhost

# Credential key pair: run `pnpm keys:generate` once (writes secrets/, gitignored).

# dev seed (profile dev): FAKE passwords, at least 12 characters.
# Admin: empty = default password DataUtama*26 (packages/db/src/seed.ts); change it after login.
SEED_ADMIN_PASSWORD=
SEED_NOC_PASSWORD=dev-noc-password-change-me
SEED_TEKNISI_PASSWORD=dev-teknisi-password-change-me

# Telegram (K2): leave empty to keep notifications in the outbox.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# api/worker database login (created by runbook J2 step 4). Empty = use the owner (dev only).
APP_DB_USER=
APP_DB_PASSWORD=
