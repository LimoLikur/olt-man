# PUBLIC_DOMAIN: localhost in dev. TLS_ISSUER: "internal" in dev, the ACME account email in production.
# Client-sent X-Forwarded-For is not trusted (no trusted_proxies): caddy sets it from the TCP peer,
# and the api trusts exactly this one hop (SPEC §8.6).
{$PUBLIC_DOMAIN:localhost} {
	tls {$TLS_ISSUER:internal}

	encode zstd gzip

	# SPEC §9: security headers on every response, including /api.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	handle /socket.io/* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv
		# index.html must not be cached (new deploys), hashed assets can be.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}

	log
}
